{
  "title": "Zesty Smoky Syrian Eggplant Skillet",
  "description": "A smoky and gooey Syrian dish featuring marmite and beurre-monte, perfect for a brunch mood, this satvik-friendly recipe is a delicious and flavorful option for any meal.",
  "cuisine": "Syrian",
  "diet": [
    "vegetarian",
    "satvik"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "marmite",
      "amount": "2 tbsp"
    },
    {
      "name": "beurre-monte",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "cherry tomatoes",
      "amount": "1 cup",
      "notes": "halved"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the eggplant cubes and cook until they are tender and lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Stir in the marmite, beurre-monte, smoked paprika, salt, and black pepper.",
    "Add the cherry tomatoes and cook for an additional 2 minutes.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Serve hot and enjoy.",
    "Garnish with fresh parsley or cilantro if desired.",
    "Serve with pita bread or over rice."
  ],
