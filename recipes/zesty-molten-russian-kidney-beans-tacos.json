{
  "title": "zesty molten russian kidney beans tacos",
  "description": "savor the flavor of molten kidney beans with a hint of russian flair, perfectly seasoned and served in a molcajete",
  "cuisine": "russian",
  "diet": [
    "fodmap-friendly",
