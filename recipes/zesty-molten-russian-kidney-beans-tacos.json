  "ingredients": [
    {
      "name": "dried kidney beans",
      "amount": "1 1/2 cups",
      "notes": ""
    },
    {
      "name": "lardons (russian bacon)",
      "amount": "6 slices",
      "notes": ""
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": ""
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": ""
    },
    {
      "name": "caraway seeds",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "dried dill weed",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "salt",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp",
      "notes": ""
    },
    {
      "name": "eggs",
      "amount": "2",
      "notes": ""
    },
    {
      "name": "all-purpose flour",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "water",
      "amount": "1 cup",
      "notes": "for the sauce"
    }
  ],
  "instructions": [
    "preheat the oven to 375\u00162f",
    "soak the kidney beans in water for 8 hours",
    "cook the kidney beans in the oven with some water for 45 minutes",
    "cook the lardons in a pan until crispy, set aside",
    "saute the onion and garlic until softened, then add caraway seeds and cook for 1 minute",
    "add the cooked kidney beans, dill weed, salt, and pepper to the pan, stir to combine",
    "in a separate pan, whisk together eggs, flour, and water, then cook over low heat until thickened",
    "add the egg mixture to the kidney bean mixture and stir to combine",
    "pour the mixture into a molcajete and top with crispy lardons",
    "bake in the oven for 10-15 minutes or until the top is golden brown"
  ],
