      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrot",
      "amount": "2 medium",
      "notes": "julienned"
    },
    {
      "name": "chickpeas",
      "amount": "1 cup",
      "notes": "cooked"
    },
    {
      "name": "dried apricots",
      "amount": "1/3 cup",
      "notes": "chopped"
    },
    {
      "name": "apple cider vinegar",
      "amount": "3 tbsp"
    },
    {
      "name": "soy sauce",
      "amount": "2 tbsp"
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "ground cumin",
      "amount": "1 tsp"
    },
    {
      "name": "fresh cilantro",
      "amount": "2 tbsp",
      "notes": "chopped, optional garnish"
    }
  ],
  "instructions": [
    "Press tofu to remove moisture, then dice and pat dry.",
    "Heat olive oil in a tagine or heavy pot over medium heat.",
    "Add onion and garlic, sauté until fragrant and translucent.",
    "Add carrot and sauté for 3 minutes.",
    "Stir in tofu, chickpeas, apricots, smoked paprika, and cumin.",
    "Pour soy sauce and apple cider vinegar over the mixture, stir to combine.",
    "Cover and simmer on low heat for 20 minutes, stirring occasionally.",
    "Taste and adjust seasoning if needed.",
    "Serve hot, garnished with fresh cilantro."
