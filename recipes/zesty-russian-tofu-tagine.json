{
  "title": "Zesty Russian Tofu Tagine",
  "description": "A bright, plant‑based tagine with tofu, apples, and a tangy apple cider vinegar finish, perfect for a festive dinner.",
  "cuisine": "Russian",
  "diet": [
    "vegan",
