      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": " Arborio rice",
      "amount": "1 cup"
    },
    {
      "name": "black pepper",
      "amount": "2 teaspoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "norwegian cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the paella pan over medium heat and add the smoked paprika and black pepper.",
    "Add the Arborio rice and stir to combine with the spices.",
    "Add the water and coconut milk, and bring to a boil.",
    "Reduce the heat to low and add the shrimp, cooking until they are pink and fully cooked.",
    "Stir in the crumbly Norwegian cheese until melted and well combined.",
    "Cover the paella pan with a leaf wrap and steam for 5 minutes.",
    "Remove the leaf wrap and sprinkle with chopped fresh parsley.",
    "Serve hot and enjoy."
  ],
