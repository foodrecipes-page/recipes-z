{
  "title": "Zesty Norwegian Shrimp Paella",
  "description": "A spicy and creamy Norwegian dish featuring black pepper and shrimp, cooked to perfection in a paella pan. This pescatarian-friendly recipe is perfect for a monsoon evening.",
  "cuisine": "Norwegian",
  "diet": [
    "pescatarian"
  ],
