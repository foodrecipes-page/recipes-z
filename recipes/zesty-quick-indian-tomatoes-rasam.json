  "instructions": [
    "Heat the cumin seeds in a large pot over medium heat until fragrant.",
    "Add the ground coriander, rasam powder, and turmeric, and cook for 1 minute.",
    "Add the canned diced tomatoes, tomato puree, salt, and water, and bring to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Use an immersion blender to puree the rasam until slightly smooth.",
    "Strain the rasam through a fine-mesh sieve into a large bowl.",
    "Shock the rasam in an ice bath to stop the cooking process.",
    "Stir in the chopped cilantro and serve hot."
  ],
