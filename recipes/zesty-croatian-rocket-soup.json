    {
      "name": "olive oil",
      "amount": "1 tbsp",
      "notes": "extra‑virgin"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "garlic cloves",
      "amount": "2",
      "notes": "minced"
    },
    {
      "name": "carrot",
      "amount": "1",
      "notes": "julienned"
    },
    {
      "name": "celery stalk",
      "amount": "1",
      "notes": "sliced"
    },
    {
      "name": "low‑sodium vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "water",
      "amount": "1 cup"
    },
    {
      "name": "lemon juice",
      "amount": "1 tbsp"
    },
    {
      "name": "red pepper flakes",
      "amount": "1 tsp"
    },
    {
      "name": "rocket (arugula) leaves",
      "amount": "2 cups",
      "notes": "packed"
    },
    {
      "name": "fresh parsley",
      "amount": "1 tbsp",
      "notes": "chopped"
    },
    {
      "name": "salt and pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the onion, garlic, carrot, and celery; sauté until softened, about 5 minutes.",
    "Pour in the vegetable broth and water, then bring to a gentle boil.",
    "Add the red pepper flakes, salt, and pepper; reduce to a simmer for 10 minutes.",
    "Stir in the lemon juice, then add the rocket leaves; simmer until wilted, about 2 minutes.",
    "Remove from heat and let cool slightly, then blend the soup until smooth using an immersion blender or transferring in batches.",
    "Return the blended soup to the pot, stir in fresh parsley, adjust seasoning if needed, and serve warm."
  ],
