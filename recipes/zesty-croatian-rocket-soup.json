{
  "title": "Zesty Croatian Rocket Soup",
  "description": "A bright, aromatic soup that pairs crunchy rocket with a gentle simmer of vegetables, finished with a splash of lemon and a hint of heat.",
  "cuisine": "Croatian",
  "diet": [
    "whole30"
  ],
