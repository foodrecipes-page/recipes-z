{
  "title": "Zesty Dense Thai Chicken Curry",
  "description": "A jammy and dense Thai dish featuring full fat sour cream and lacquer glaze, perfect for meal prep. This kosher friendly recipe is easy to make and delicious to eat.",
  "cuisine": "Thai",
  "diet": [
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "full fat sour cream",
      "amount": "1 cup"
    },
    {
      "name": "Thai red curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "lacquer glaze",
      "amount": "1/4 cup"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium high heat.",
    "Add the chicken to the pan and cook until browned on all sides.",
    "Add the curry paste to the pan and cook for 1 minute.",
    "Add the coconut milk, fish sauce, and brown sugar to the pan and stir to combine.",
    "Bring the mixture to a simmer and cook until the chicken is cooked through.",
    "Stir in the sour cream and lacquer glaze.",
    "Reduce the heat to low and cook for an additional 5 minutes.",
    "Serve the curry hot over rice or noodles."
  ],
