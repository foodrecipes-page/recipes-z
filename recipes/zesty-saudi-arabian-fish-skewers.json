{
  "title": "Zesty Saudi Arabian Fish Skewers",
  "description": "A kid-friendly Saudi Arabian dish featuring fermented branston pickle and juicy fish, served on a tagliere",
  "cuisine": "Saudi Arabian",
  "diet": [
    "pescatarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "cod fish",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "branston pickle",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "pickle juice",
      "amount": "1/4 cup",
      "notes": "from a jar of pickles"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, salt, and black pepper",
    "Add the chopped branston pickle and pickle juice to the bowl and stir to combine",
    "Add the fish cubes to the bowl and toss to coat with the marinade",
    "Thread the marinated fish cubes onto skewers, leaving a small space between each piece",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the fish is cooked through",
    "Serve the skewers on a tagliere, garnished with additional chopped branston pickle if desired"
  ],
