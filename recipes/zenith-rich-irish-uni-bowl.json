  "title": "Zenith Rich Irish Uni Bowl",
  "description": "A rich and creamy Irish dish featuring uni, served in a stone bowl, perfect for a special occasion.",
  "cuisine": "Irish",
  "diet": [
    "gluten-free",
    "shellfish"
  ],
