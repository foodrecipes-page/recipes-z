    {
      "name": "uni",
      "amount": "1 cup",
      "notes": "fresh"
    },
    {
      "name": "irish butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "irish cheddar",
      "amount": "1/2 cup",
      "notes": "shredded"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and diced"
    },
    {
      "name": "leeks",
      "amount": "2 medium",
      "notes": "cleaned and sliced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large pot, boil the diced potatoes until they are tender.",
    "In a separate pan, melt the irish butter over medium heat.",
    "Add the sliced leeks to the pan and cook until they are softened.",
    "In a large bowl, combine the cooked potatoes, leeks, and heavy cream.",
    "Stir in the shredded irish cheddar until it is melted and well combined.",
    "Add the fresh uni to the bowl and stir gently.",
    "Season the mixture with salt and black pepper to taste.",
    "Transfer the mixture to a stone bowl and serve immediately."
  ],
