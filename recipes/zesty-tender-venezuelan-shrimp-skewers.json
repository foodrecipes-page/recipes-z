      "name": "large shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "lemongrass stalks",
      "amount": "4",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "2",
      "notes": "chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, garlic, black pepper, and salt.",
    "Add the chopped onion, carrot, and celery to the bowl and stir to combine.",
    "Add the shrimp to the bowl and toss to coat with the mirepoix mixture.",
    "Thread the shrimp, lemongrass stalks, and mirepoix mixture onto skewers.",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the shrimp are pink and cooked through.",
    "Garnish with chopped fresh cilantro and serve immediately.",
    "Serve with your choice of side dishes, such as rice or roasted vegetables."
  ],
