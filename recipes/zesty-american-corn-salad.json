  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "fresh corn kernels",
      "amount": "4 cups",
      "notes": "freshly popped or canned, drained"
    },
    {
      "name": "red bell pepper",
      "amount": "1 cup",
      "notes": "diced"
    },
    {
      "name": "red onion",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lime juice",
      "amount": "4 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "hot sauce",
      "amount": "2 tablespoons",
      "notes": "adjust to taste"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "1 tablespoon",
      "notes": "for dressing"
    },
    {
      "name": "black pepper",
      "amount": "1/8 teaspoon",
      "notes": "optional, for mild heat"
    }
  ],
  "instructions": [
    "Boil water in a medium pot and cook corn kernels for 4 minutes, then drain and cool under cold water.",
    "In a large bowl combine the cooked corn, diced red bell pepper, chopped red onion, and cilantro.",
    "In a small bowl whisk together lime juice, hot sauce, olive oil, and pepper until emulsified.",
    "Pour the dressing over the corn mixture and toss until evenly coated.",
    "Taste and add a pinch of salt if desired, keeping it minimal for low-sodium use.",
    "Refrigerate the salad for 15 minutes before serving to let flavors meld."
  ],
