{
  "title": "Zesty Smoky Middle Eastern Chickpeas Falafel",
  "description": "A smoky and snappy kid-friendly Middle Eastern dish featuring high-protein chickpeas, formed into crispy falafel and served in a lacquerware bowl.",
  "cuisine": "Middle Eastern",
  "diet": [
