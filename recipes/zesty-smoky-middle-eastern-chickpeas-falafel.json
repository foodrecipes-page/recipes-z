      "amount": "1 1/2 cups",
      "notes": "drained and rinsed"
    },
    {
      "name": "vegetable shortening",
      "amount": "1/4 cup",
      "notes": "melted"
    },
    {
      "name": "char-grill seasoning",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
