  "ingredients": [
    {
      "name": "2 tbsp creme-patissiere",
      "amount": "2"
    },
    {
      "name": "1 can (400g) diced tomatoes, drained",
      "amount": "1"
    },
    {
      "name": "1 small red onion, finely chopped",
      "amount": "1"
    },
    {
      "name": "2 cloves garlic, minced",
      "amount": "2"
    },
    {
      "name": "1 tsp dried oregano",
      "amount": "1"
    },
    {
      "name": "1/2 cup cherry tomatoes, halved",
      "amount": "1/2"
    },
    {
      "name": "1 tbsp lemon zest",
      "amount": "1"
    },
    {
      "name": "1/4 cup fresh parsley, chopped",
      "amount": "1/4"
    }
  ],
  "instructions": [
    "Preheat oven to 350°F (175°C).",
    "Spread diced tomatoes evenly on a cedar plank.",
    "Add creme-patissiere and cherry tomatoes over the tomatoes.",
    "Sprinkle chopped red onion, garlic, oregano, lemon zest, and parsley over the mixture.",
    "Bake for 20 minutes or until tomatoes are tender and golden brown.",
    "Serve warm as a side dish or on a larger plate to serve as main course.",
    "Garnish with extra fresh herbs if desired."
