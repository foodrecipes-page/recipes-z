{
  "title": "Zesty Buttery Turkish Lamb Kebabs",
  "description": "A cozy Turkish dish featuring lamb, Grand Marnier, and confit tomatoes, perfect for a dinner gathering.",
  "cuisine": "Turkish",
  "diet": [
    "gluten-free",
