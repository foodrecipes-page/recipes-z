  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "Grand Marnier",
      "amount": "2 tablespoons"
    },
    {
      "name": "confit tomatoes",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together melted butter, Grand Marnier, garlic, paprika, salt, and black pepper.",
    "Add the lamb cubes to the bowl and toss to coat with the butter mixture.",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece.",
    "Grill the kebabs for 8-10 minutes, turning occasionally, until the lamb is cooked to an internal temperature of 145 degrees.",
    "Meanwhile, heat the confit tomatoes in a saucepan over low heat.",
    "Serve the kebabs with the warmed confit tomatoes and garnish with chopped parsley.",
    "Let the kebabs rest for 5 minutes before serving.",
    "Serve immediately and enjoy."
  ],
