    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium-high heat.",
    "Add the lamb pieces and cook until browned, about 5 minutes.",
    "Add the chopped onion and cook until softened, about 3 minutes.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the red wine, soy sauce, and dark brown sugar, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to medium-low and simmer for 10 minutes.",
    "Add the chopped bell pepper and cook until tender, about 5 minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot over rice or noodles."
