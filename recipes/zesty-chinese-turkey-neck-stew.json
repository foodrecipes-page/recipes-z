      "amount": "1/4 cup"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the sesame oil in the cataplana vessel over medium heat.",
    "Add the chopped onion, carrot, and celery, and cook until the vegetables are tender.",
    "Add the sliced ginger and cook for 1 minute.",
    "Add the turkey neck and cook until browned on all sides.",
    "Add the soy sauce and enough water to cover the ingredients, then bring to a boil.",
    "Reduce the heat to low and simmer for 1 hour.",
    "Add the minced garlic and cook for an additional 10 minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with chopped scallions."
  ],
