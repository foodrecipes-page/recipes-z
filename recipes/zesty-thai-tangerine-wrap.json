      "amount": "1/2 teaspoon"
    },
    {
      "name": "Green Onions",
      "amount": "2 green onions, thinly sliced"
    },
    {
      "name": "Thyme Sprigs",
      "amount": "1 sprig per person (optional)"
    },
    {
      "name": "Wrap Leaves",
      "amount": "4-6 leaves (such as lettuce or cabbage), chopped"
    }
  ],
  "instructions": [
    "Combine V Sterbottensost Cheese, lime juice, red chili slices, tangerine zest, and green onions in a small bowl.",
