{
  "title": "Zesty Nutty Indian Chicken Curry",
  "description": "A nutty and tender Indian chicken curry featuring Thai chilli jam and coconut cream, perfect for a weeknight dinner",
  "cuisine": "Indian",
  "diet": [
    "low-sodium"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "Thai chilli jam",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut cream",
      "amount": "1/2 cup"
    },
    {
      "name": "cashews",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "curry powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a blender or food processor, blend the cashews and 2 tablespoons of water until smooth.",
    "In a large skillet, heat the olive oil over medium heat and cook the onion until softened.",
    "Add the garlic and cook for 1 minute.",
    "Add the chicken and cook until browned on all sides.",
    "In a small bowl, mix the Thai chilli jam, coconut cream, curry powder, salt, and black pepper.",
    "Pour the mixture over the chicken and stir to combine.",
    "Transfer the mixture to 4 ramekins and top each with the cashew mixture.",
    "Bake for 25 minutes or until the chicken is cooked through."
  ],
