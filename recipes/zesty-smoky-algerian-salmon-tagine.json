  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, ginger, cumin, paprika, salt, and black pepper",
    "Add the smoked salmon to the bowl and toss to coat with the marinade",
    "Transfer the salmon to a baking dish and top with confit tomato",
    "Bake for 12 minutes or until the salmon is cooked through",
    "Remove from the oven and let rest for 2 minutes",
    "Serve hot, garnished with fresh parsley or cilantro",
    "Refrigerate or freeze leftovers for up to 3 days"
  ],
