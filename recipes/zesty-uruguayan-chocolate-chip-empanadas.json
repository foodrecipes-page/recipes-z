{
  "title": "Zesty Uruguayan Chocolate Chip Empanadas",
  "description": "A festive Uruguayan dish featuring chocolate chips, perfect for a sweet treat, this recipe is egg-free-friendly and combines pungent and juicy flavors.",
  "cuisine": "Uruguayan",
  "diet": [
    "vegetarian"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "all purpose flour",
      "amount": "2 cups",
      "notes": "sifted"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "granulated sugar",
      "amount": "1 cup"
    },
    {
      "name": "semisweet chocolate chips",
      "amount": "1 cup"
    },
    {
      "name": "orange zest",
      "amount": "1 tablespoon"
    },
    {
      "name": "orange juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cinnamon",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees.",
    "In a large bowl, combine flour, sugar, and salt.",
    "Add melted butter, orange zest, and orange juice to the bowl and mix until a dough forms.",
    "Knead the dough for 5 minutes until it becomes smooth.",
    "Divide the dough into 8 equal pieces.",
    "Roll out each piece into a thin circle.",
    "Place 1-2 tablespoons of chocolate chips in the center of each circle.",
    "Fold the dough in half and press the edges together to seal the empanada.",
    "Place the empanadas on a baking sheet lined with parchment paper.",
    "Bake for 20-25 minutes or until golden brown."
  ],
