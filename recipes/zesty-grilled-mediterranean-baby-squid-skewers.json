{
  "title": "Zesty Grilled Mediterranean Baby Squid Skewers",
  "description": "A fresh and flavorful Mediterranean dish featuring baby squid, perfect for a date night, and keto-friendly.",
  "cuisine": "Mediterranean",
  "diet": [
    "keto",
    "low-carb",
