{
  "title": "Zesty Kenyan Peanut Cookies",
  "description": "Tender and sour Kenyan dish featuring peanut cookies and pickle, perfect for a lazy Sunday, and keto-friendly.",
  "cuisine": "Kenyan",
  "diet": [
    "keto",
    "low-carb"
  ],
