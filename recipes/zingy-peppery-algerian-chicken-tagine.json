      "amount": "1 tablespoon"
    },
    {
      "name": "cinnamon powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "In a large clay pot or Dutch oven, heat the olive oil over medium heat.",
    "Add the chicken breast and cook until browned, about 5 minutes.",
    "Add the cumin powder, coriander powder, paprika, cayenne pepper, salt, and pepper, and stir to combine.",
    "Cook for another 2 minutes.",
    "Add the chicken broth, honey, and sriracha sauce, and bring to a simmer.",
    "Reduce heat to low and cook, covered, for 10 minutes, or until the chicken is cooked through.",
    "Stir in the chopped cilantro and serve over toasted bread.",
    "Garnish with additional cilantro, if desired.",
    "Serve hot and enjoy!"
  ],
