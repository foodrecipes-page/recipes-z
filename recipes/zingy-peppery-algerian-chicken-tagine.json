      "amount": "1 pound",
      "notes": "boneless, skinless"
    },
    {
      "name": "sriracha sauce",
      "amount": "2 tablespoons",
      "notes": "adjust to taste"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon",
      "notes": "smoked paprika"
    },
    {
      "name": "cumin powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon",
      "notes": "optional, to taste"
    },
    {
