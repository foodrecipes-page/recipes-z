{
  "title": "Zesty Light Croatian Pea Eggplant Skillet",
  "description": "A salty and shaggy Croatian dish featuring pea and eggplant, infused with oil and friendly to dairy-free diets. This light skillet is perfect for a weeknight dinner.",
  "cuisine": "Croatian",
  "diet": [
    "dairy-free",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "sliced into 1/2 inch thick rounds"
    },
    {
      "name": "peas",
      "amount": "1 cup",
      "notes": "fresh or frozen"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chopped parsley",
      "amount": "1/4 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the sliced eggplant and cook for 5 minutes on each side, until golden brown.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the peas, paprika, salt, and black pepper, and cook for 2 minutes, until the peas are tender.",
    "Squeeze the lemon juice over the skillet and stir to combine.",
    "Taste and adjust the seasoning as needed.",
    "Garnish with chopped parsley, if desired.",
    "Serve hot and enjoy."
  ],
