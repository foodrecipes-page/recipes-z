  "ingredients": [
    {
      "name": "chopped tomatoes",
      "amount": "2 cups",
      "notes": "fresh and ripe"
    },
    {
      "name": "shio-cure",
      "amount": "1/4 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "korean chili flakes",
      "amount": "2 tbsp"
    },
    {
      "name": "soy sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "2 tbsp"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "tofu",
      "amount": "1 cup",
      "notes": "cubed and drained"
    },
    {
      "name": "aerating agent",
      "amount": "1 tsp",
      "notes": "such as baking soda or natural yeast"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a large pot over medium heat",
    "Add the minced garlic and grated ginger and saute for 1 minute",
    "Add the chopped tomatoes, shio-cure, korean chili flakes, and soy sauce, and stir to combine",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes",
    "Add the cubed tofu and cook for an additional 5 minutes",
    "Stir in the aerating agent and cook for 1 minute, or until the stew is lightly aerated",
    "Taste and adjust the seasoning as needed",
    "Serve the stew hot, garnished with chopped scallions"
  ],
