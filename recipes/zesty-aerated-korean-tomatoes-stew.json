{
  "title": "Zesty Aerated Korean Tomatoes Stew",
  "description": "A floral and aerated one-pot Korean dish featuring chopped tomatoes and shio-cure, friendly to plant-based diets",
  "cuisine": "Korean",
  "diet": [
    "plant-based",
    "vegetarian"
  ],
