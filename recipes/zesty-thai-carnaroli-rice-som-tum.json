{
  "title": "Zesty Thai Carnaroli Rice Som Tum",
  "description": "A fresh and molten Thai dish featuring Carnaroli rice, wok-hei, and macrobiotic-friendly ingredients, served in a traditional Som Tum form.",
  "cuisine": "Thai",
  "diet": [
    "macrobiotic",
