      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "slice into thin strips"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "nuka-pickle",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "rice noodles",
      "amount": "8 ounces"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the extra virgin olive oil in a large skillet over medium-high heat.",
    "Add the pork shoulder and cook until browned, about 5 minutes.",
    "Add the grated ginger and minced garlic and cook for 1 minute.",
    "Add the chopped nuka-pickle, soy sauce, and turmeric, and stir to combine.",
    "Add the rice noodles and cook, stirring constantly, until the noodles are well coated with the sauce.",
    "Reduce heat to low and simmer, covered, for 10 minutes.",
    "Stir in the chopped green onions and serve hot.",
    "Garnish with additional green onions and nuka-pickle, if desired."
  ],
