      "notes": "fresh"
    },
    {
      "name": "orange juice",
      "amount": "1/2 cup"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp"
    },
    {
      "name": "dried oregano",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together orange juice, lemon juice, olive oil, garlic powder, dried oregano, salt, and pepper.",
    "Add the mozzarella balls to the bowl and toss to coat with the citrus mixture.",
    "Thread 3-4 mozzarella balls onto each skewer.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Bake for 10-12 minutes or until the mozzarella is lightly browned.",
    "Remove from the oven and sprinkle with chopped parsley.",
    "Serve hot and enjoy!",
    "Refrigerate any leftovers for up to 24 hours."
  ],
