{
  "title": "Zesty Uruguayan Corn Salad",
  "description": "A tangy, crunchy salad that blends fresh corn with a warm soffritto base and aromatic cumin, perfect for a low-sodium meal.",
  "cuisine": "Uruguayan",
  "diet": [
    "vegetarian",
