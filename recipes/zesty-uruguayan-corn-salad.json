      "name": "fresh corn kernels",
      "amount": "2 cups"
    },
    {
      "name": "red bell pepper, diced",
      "amount": "1 cup"
    },
    {
      "name": "red onion, diced",
      "amount": "1/2 cup"
    },
    {
      "name": "fresh cilantro, chopped",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt substitute",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/8 teaspoon",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Heat the olive oil in a medium skillet over medium heat.",
    "Add the diced onion and bell pepper and sauté until softened, about 3 minutes.",
    "Stir in the cumin, smoked paprika, salt substitute, black pepper, and cayenne pepper, cooking until fragrant, 30 seconds.",
    "Add the corn kernels to the skillet and cook until warmed through, about 2 minutes.",
    "Remove the skillet from heat and let the mixture cool slightly.",
    "Transfer the warm mixture to a bowl and squeeze lime juice over it, tossing gently.",
    "Fold in the chopped cilantro until evenly distributed.",
    "Serve the salad at room temperature, garnished with extra cilantro if desired."
  ],
