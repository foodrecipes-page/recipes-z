    },
    {
      "name": "olive oil",
      "amount": "1 tbsp",
      "notes": "for sauté"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the minced garlic and chopped onion, sauté until fragrant and translucent.",
    "Stir in the diced tomato, eggplant, bitter melon, okra, and pumpkin, cooking for about 5 minutes.",
    "Add the sliced chicken breast pieces and cook until they start to brown on all sides.",
    "Pour in the water, fish sauce, and soy sauce, and bring to a boil.",
    "Reduce heat to a simmer and cover, braising for 15 minutes until the chicken is cooked through and the vegetables are tender.",
    "Uncover, increase heat slightly, and let the sauce reduce until slightly thickened, about 3-5 minutes.",
    "Serve hot, garnished with sliced red chili if desired."
  ],
