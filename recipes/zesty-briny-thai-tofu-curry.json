{
  "title": "Zesty Briny Thai Tofu Curry",
  "description": "A weeknight Thai dish featuring marinated tofu and ferment-jang, this curry is a perfect blend of briny and gooey flavors, all in a vegan-friendly package.",
  "cuisine": "Thai",
  "diet": [
    "vegan",
