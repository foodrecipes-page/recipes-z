  "ingredients": [
    {
      "name": "firm tofu",
      "amount": "1 block",
      "notes": "drained and cut into cubes"
    },
    {
      "name": "ferment-jang",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "Thai red curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "fish-free sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 teaspoon"
    },
    {
      "name": "rice vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the curry paste and cook for 1 minute, stirring constantly.",
    "Add the ferment-jang, fish-free sauce, and sugar, and cook for another minute.",
    "Add the tofu and cook until it is lightly browned on all sides.",
    "Add the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the curry simmer for 10 minutes.",
    "Stir in the rice vinegar and season with salt to taste.",
    "Serve the curry hot over rice or noodles."
  ],
