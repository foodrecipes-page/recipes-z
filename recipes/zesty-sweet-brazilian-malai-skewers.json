{
  "title": "Zesty Sweet Brazilian Malai Skewers",
  "description": "A sweet and springy Brazilian dish featuring malai and bonito flakes, perfect for kids and adults alike, with a mediterranean twist",
  "cuisine": "Brazilian",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
