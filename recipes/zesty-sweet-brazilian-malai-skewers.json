  "ingredients": [
    {
      "name": "malai",
      "amount": "1 cup",
      "notes": "sweetened condensed milk"
    },
    {
      "name": "bonito flakes",
      "amount": "1/4 cup"
    },
    {
      "name": "pineapple chunks",
      "amount": "1 cup"
    },
    {
      "name": "coconut flakes",
      "amount": "1/2 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "bamboo skewers",
      "amount": "10-12",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the grill to medium heat",
    "Thread malai, pineapple chunks, and coconut flakes onto the bamboo skewers",
    "Drizzle lemon juice and olive oil over the skewers",
    "Sprinkle bonito flakes, garlic powder, and salt over the skewers",
    "Grill the skewers for 5-7 minutes per side, or until lightly browned",
    "Serve warm and enjoy",
    "Garnish with additional coconut flakes and bonito flakes if desired",
    "Refrigerate any leftovers for up to 24 hours"
  ],
