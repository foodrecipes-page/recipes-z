      "amount": "1 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "Queso fresco",
      "amount": "1/2 cup crumbled"
    },
    {
      "name": "Toasted walnuts",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat oven to 425°F.",
    "In a bowl, combine pumpkin cubes, olive oil, rosemary, thyme, paprika, cumin, honey, lemon zest, salt, and pepper; toss until coated.",
    "Spread the mixture in a single layer on a rimmed baking sheet.",
    "Roast for 25 minutes, stirring halfway, until edges caramelize.",
    "Remove from oven and let cool 5 minutes.",
    "Sprinkle crumbled queso fresco evenly over the roasted pumpkin.",
    "Drizzle a little extra honey for glossy finish.",
    "Garnish with toasted walnuts and serve hot."
  ],
