      "notes": "cube"
    },
    {
      "name": "Olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "Fresh rosemary",
      "amount": "1 tbsp chopped"
    },
    {
      "name": "Fresh thyme",
      "amount": "1 tbsp chopped"
    },
    {
      "name": "Smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "Ground cumin",
      "amount": "1 tsp"
    },
    {
      "name": "Honey",
      "amount": "1 tbsp"
    },
    {
      "name": "Lemon zest",
      "amount": "1 tbsp"
    },
    {
