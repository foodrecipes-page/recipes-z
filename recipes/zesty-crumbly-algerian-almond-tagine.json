      "notes": "sliced"
    },
    {
      "name": "fresh basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, mix together the sliced almonds, chopped basil, and minced garlic.",
    "In a small bowl, whisk together the olive oil, lemon juice, salt, and black pepper.",
    "Pour the wet ingredients over the dry ingredients and stir until well combined.",
    "Transfer the mixture to a baking dish and top with crumbly feta cheese.",
    "Bake for 20 minutes or until the almonds are lightly toasted.",
    "Remove from the oven and let cool for 5 minutes before serving.",
    "Serve warm and enjoy!",
    "Garnish with additional chopped basil if desired."
  ],
