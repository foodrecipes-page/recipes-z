{
  "title": "Zesty Light Peruvian Semolina Rocoto Relleno",
  "description": "A light and zesty Peruvian dish featuring semolina rimacinata and rocoto relleno, perfect for a dinner meal, dairy-free friendly and cultured with namul blanch season.",
  "cuisine": "Peruvian",
  "diet": [],
