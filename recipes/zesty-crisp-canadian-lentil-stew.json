{
  "title": "Zesty Crisp Canadian Lentil Stew",
  "description": "A hearty one-pot dish featuring tamarind paste and a soffritto base, perfect for a weeknight dinner",
  "cuisine": "Canadian",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lentils",
      "amount": "1 cup",
      "notes": "green or brown lentils work well"
    },
    {
      "name": "tamarind paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "diced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can",
      "notes": "14.5 oz"
    },
    {
      "name": "spinach",
      "amount": "1 cup",
      "notes": "fresh"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat",
    "Add the diced onion, carrots, and celery and cook until the vegetables are tender, about 8 minutes",
    "Add the minced garlic and cook for 1 minute, until fragrant",
    "Stir in the tamarind paste and cook for 1 minute, until well combined",
    "Add the lentils, vegetable broth, diced tomatoes, salt, and pepper, and bring to a boil",
    "Reduce the heat to low and simmer, covered, for 30 minutes, or until the lentils are tender",
    "Stir in the fresh spinach and cook until wilted, about 2 minutes",
    "Serve hot, garnished with chopped fresh herbs if desired"
  ],
