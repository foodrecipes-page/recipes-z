      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cumin",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chopped cilantro",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the salt block over medium heat for 10 minutes.",
    "In a small bowl, whisk together lime juice, olive oil, salt, black pepper, and cumin.",
    "Add the danmuji to the bowl and toss to coat with the lime juice mixture.",
    "Warm the corn tortillas by wrapping them in a damp paper towel and microwaving for 20 seconds.",
    "Assemble the tacos by spooning the danmuji mixture onto a tortilla and topping with chopped cilantro.",
    "Steam the tacos on the preheated salt block for 2 minutes on each side.",
    "Serve immediately and enjoy.",
    "Garnish with additional cilantro and lime wedges if desired."
  ],
