{
  "title": "Zesty Mexican Danmuji Tacos",
  "description": "A citrusy and springy post-workout Mexican dish featuring danmuji, perfect for a refreshing meal, prepared on a salt block for added flavor.",
  "cuisine": "Mexican",
  "diet": [
    "vegetarian"
  ],
