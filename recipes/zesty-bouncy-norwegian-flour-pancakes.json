{
  "title": "Zesty Bouncy Norwegian Flour Pancakes",
  "description": "A traditional Norwegian dish featuring strong white flour, these pancakes are tangy and bouncy, perfect for a sattvic-friendly breakfast",
  "cuisine": "Norwegian",
  "diet": [
    "vegetarian",
    "ayurvedic"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "strong white flour",
      "amount": "2 cups",
      "notes": "preferably unbleached"
    },
    {
      "name": "plain yogurt",
      "amount": "1 cup"
    },
    {
      "name": "milk",
      "amount": "1/2 cup"
    },
    {
      "name": "egg",
      "amount": "1 large"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "baking powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "lemon zest",
      "amount": "1 tablespoon"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons",
      "notes": "melted"
    }
  ],
  "instructions": [
    "In a large bowl, whisk together the flour, sugar, salt, and baking powder",
    "In a separate bowl, whisk together the yogurt, milk, egg, and melted butter",
    "Add the wet ingredients to the dry ingredients and stir until just combined",
    "Stir in the lemon zest",
    "Let the batter rest for 30 minutes to allow the flour to absorb the liquid",
    "Heat a non-stick skillet or griddle over medium heat",
    "Drop the batter by 1/4 cupfuls onto the skillet or griddle",
    "Cook the pancakes for 2-3 minutes, until bubbles appear on the surface and the edges start to dry",
    "Flip the pancakes and cook for another 1-2 minutes, until golden brown"
  ],
