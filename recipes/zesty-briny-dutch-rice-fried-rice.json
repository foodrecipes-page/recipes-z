{
  "title": "Zesty Briny Dutch Rice Fried Rice",
  "description": "A plant-based Dutch-inspired fried rice dish with a dense and briny flavor, featuring red food coloring and a mix of spices, perfect for a brunch mood.",
  "cuisine": "Dutch",
  "diet": [
    "vegetarian",
