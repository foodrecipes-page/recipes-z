  "ingredients": [
    {
      "name": "cooked rice",
      "amount": "2 cups",
      "notes": "preferably day-old rice"
    },
    {
      "name": "red food coloring",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "plant-based stir-fry sauce",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a large skillet over medium-high heat.",
    "Add the chopped onion and cook until translucent, about 3 minutes.",
    "Add the minced garlic and cook for another minute, stirring constantly.",
    "Add the smoked paprika, salt, and black pepper, and stir to combine.",
    "Add the cooked rice to the skillet, breaking up any clumps with a spatula.",
    "Stir in the red food coloring and plant-based stir-fry sauce.",
    "Cook for about 5 minutes, stirring frequently, until the rice is heated through and starting to brown.",
    "Taste and adjust the seasoning as needed.",
    "Serve hot and enjoy."
  ],
