{
  "title": "Zesty Sweet Brazilian Epoisses Gratin",
  "description": "A sweet and gooey one-pot Brazilian dish featuring epoisses cheese, cooked in a bain-marie for a low-fat friendly meal option.",
  "cuisine": "Brazilian",
  "diet": [
    "low-fat",
    "vegetarian"
  ],
