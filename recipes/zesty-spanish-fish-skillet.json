{
  "title": "Zesty Spanish Fish Skillet",
  "description": "A winey and juicy Spanish dish featuring tomato juice and score fat, perfect for pescatarians, made in a cast iron skillet.",
  "cuisine": "Spanish",
  "diet": [
    "pescatarian"
  ],
