  "ingredients": [
    {
      "name": "Cod fish",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "Tomato juice",
      "amount": "1 cup"
    },
    {
      "name": "Olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Score fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "White wine",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large cast iron skillet over medium high heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the cod fish and cook until browned on all sides, about 5 minutes.",
    "Add the tomato juice, score fat, smoked paprika, salt, and black pepper, and stir to combine.",
    "Reduce heat to medium low and simmer, covered, for 10 minutes.",
    "Add the white wine and stir to combine.",
    "Continue to simmer, uncovered, for an additional 5 minutes.",
    "Serve hot, garnished with chopped fresh parsley if desired."
  ],
