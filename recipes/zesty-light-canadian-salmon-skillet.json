  "instructions": [
    "Preheat the sous-vide machine to 120 degrees Fahrenheit",
    "Season the salmon fillets with salt, pepper, and garlic powder",
    "Place the salmon fillets in a sous-vide bag and seal",
    "Cook the salmon for 12 minutes",
    "Heat the olive oil in a large skillet over medium-high heat",
    "Add the chopped parsley and cook for 1 minute",
    "Remove the salmon from the sous-vide bag and add to the skillet",
    "Squeeze the lemon juice over the salmon and sprinkle with lemon zest",
    "Cook for an additional 2 minutes",
    "Serve hot and enjoy"
