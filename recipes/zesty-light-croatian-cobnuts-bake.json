{
  "title": "Zesty Light Croatian Cobnuts Bake",
  "description": "A floral and light Croatian dish featuring cobnuts, this bake is perfect for adventurous eaters, and is shojin-friendly, making it suitable for those following a Buddhist diet",
  "cuisine": "Croatian",
  "diet": [
    "shojin",
