      "name": "cobnuts",
      "amount": "1 1/2 cups",
      "notes": "shelled and chopped"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "rose petal jam",
      "amount": "1 tablespoon"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "flour",
      "amount": "1 cup"
    },
    {
      "name": "baking powder",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour and baking powder.",
    "In a separate bowl, mix together the olive oil, honey, lemon juice, rose petal jam, and vanilla extract.",
    "Add the wet ingredients to the dry ingredients and stir until just combined.",
    "Fold in the chopped cobnuts.",
    "Pour the mixture into a greased 8 inch round baking dish.",
    "Bake for 35 minutes, or until the edges are lightly golden.",
    "Remove from the oven and let cool for 10 minutes before serving."
  ],
