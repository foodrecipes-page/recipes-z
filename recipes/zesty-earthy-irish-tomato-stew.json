      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups",
      "notes": "low sodium"
    },
    {
      "name": "thyme",
      "amount": "1 tsp",
      "notes": "dried"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp",
      "notes": "extra virgin"
    }
  ],
  "instructions": [
    "Heat the olive oil in the pressure cooker over medium heat.",
    "Add the chopped onions and cook until they are translucent.",
    "Add the sliced mushrooms and cook until they release their liquid and start to brown.",
    "Add the chopped carrots and potatoes, and cook for 5 minutes.",
    "Add the tomato juice, vegetable broth, and dried thyme, and stir to combine.",
    "Close the pressure cooker and cook for 20 minutes.",
    "Let the pressure release naturally, then open the lid and season with salt and pepper to taste.",
    "Serve the stew hot, garnished with fresh herbs if desired."
  ],
