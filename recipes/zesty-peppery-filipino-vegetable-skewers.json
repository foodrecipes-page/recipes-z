      "amount": "1 cup",
      "notes": "button or cremini"
    },
    {
      "name": "Cherry tomatoes",
      "amount": "1 pint",
      "notes": "halved"
    },
    {
      "name": "Zucchini",
      "amount": "1 medium",
      "notes": "cut into 1-inch slices"
    },
    {
      "name": "Black pepper",
      "amount": "1 tsp",
      "notes": "freshly ground"
    },
    {
      "name": "Salt",
      "amount": "1 tsp",
      "notes": "or to taste"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together the vegan white wine vinegar, beurre-monte, black pepper, and salt",
    "Add the cut vegetables to the bowl and toss to coat with the marinade",
    "Thread the marinated vegetables onto skewers, leaving a little space between each piece",
    "Brush the grill with oil to prevent sticking",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the vegetables are tender and lightly charred",
    "Serve the skewers hot on a tagliere, garnished with fresh herbs if desired"
  ],
