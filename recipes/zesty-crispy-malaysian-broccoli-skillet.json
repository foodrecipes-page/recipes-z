{
  "title": "Zesty Crispy Malaysian Broccoli Skillet",
  "description": "A malty, crispy, and cozy Malaysian dish featuring purple-sprouting-broccoli, this recipe is perfect for a weeknight dinner. It is halal-friendly and cooked to perfection in a cazuela.",
  "cuisine": "Malaysian",
  "diet": [],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "purple-sprouting-broccoli",
      "amount": "1 bunch",
      "notes": "cut into florets"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "malay curry powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "malt vinegar",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large cazuela over medium-high heat.",
    "Add the onion and cook until it is translucent.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the broccoli and cook until it is tender and slightly browned.",
    "Add the curry powder, salt, and pepper, and stir to combine.",
    "Cook for an additional 2 minutes.",
    "Stir in the malt vinegar.",
    "Transfer the cazuela to the broiler and cook until the top is crispy and golden brown.",
    "Remove from the oven and serve hot."
  ],
