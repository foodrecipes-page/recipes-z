  "title": "Zesty Smoky American Chicken Grill",
  "description": "A high protein American dish featuring curry powder and wood fired baking, perfect for a weeknight dinner",
  "cuisine": "American",
  "diet": [
    "high-protein",
    "gluten-free"
  ],
