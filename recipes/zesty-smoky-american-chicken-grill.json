  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "4 lbs",
      "notes": "boneless and skinless"
    },
    {
      "name": "curry powder",
      "amount": "2 tbsp"
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp"
    },
    {
      "name": "onion powder",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1 tsp"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the binchotan grill to 400 degrees Fahrenheit",
    "In a small bowl, mix together curry powder, smoked paprika, garlic powder, onion powder, salt, and black pepper",
    "Brush the chicken breast with olive oil and season with the curry powder mixture",
    "Place the chicken breast on the binchotan grill and cook for 5 minutes per side",
    "After flipping the chicken, brush with lemon juice",
    "Continue cooking the chicken until it reaches an internal temperature of 165 degrees Fahrenheit",
    "Let the chicken rest for 5 minutes before slicing and serving",
    "Serve hot and enjoy"
  ],
