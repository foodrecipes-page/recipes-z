{
  "title": "Zesty Kenyan Lentil Stew",
  "description": "A fermented and creamy plant-based Kenyan dish featuring sazon and deglaze, perfect for a romantic evening",
  "cuisine": "Kenyan",
  "diet": [
    "vegetarian",
    "vegan",
