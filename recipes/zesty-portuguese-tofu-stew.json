{
  "title": "Zesty Portuguese Tofu Stew",
  "description": "A pungent and velvety stew featuring soya milk and char-grill flavors, perfect for a post-workout meal",
  "cuisine": "Portuguese",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "extra firm tofu",
      "amount": "1 block",
      "notes": "drained and cut into 1 inch cubes"
    },
    {
      "name": "soya milk",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large cazuela over medium heat",
    "Add the chopped onion and cook until softened, about 5 minutes",
    "Add the minced garlic and cook for an additional minute",
    "Add the smoked paprika, cumin, turmeric, salt, and black pepper, and cook for 1 minute",
    "Add the cubed tofu and cook until lightly browned, about 5 minutes",
    "Add the soya milk and stir to combine",
    "Bring the mixture to a simmer and cook until the stew has thickened, about 20 minutes",
    "Serve hot, garnished with chopped fresh herbs if desired"
  ],
