  "ingredients": [
    {
      "name": "almond flour",
      "amount": "2 cups",
      "notes": "finely ground"
    },
    {
      "name": "eggs",
      "amount": "4 large",
      "notes": "room temperature"
    },
    {
      "name": "sour cream",
      "amount": "1 cup",
      "notes": "full-fat"
    },
    {
      "name": "honey",
      "amount": "1/4 cup",
      "notes": "optional"
    },
    {
      "name": "dried corn kernels",
      "amount": "1 cup",
      "notes": "unsweetened"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "unrefined"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "freshly ground"
    },
    {
      "name": "fermented vegetable powder",
      "amount": "1 tablespoon",
      "notes": "homemade or store-bought"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the almond flour, eggs, sour cream, honey, salt, and black pepper.",
    "Stir in the dried corn kernels and fermented vegetable powder.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 35 minutes or until the edges are golden brown.",
    "Remove from the oven and let cool for 10 minutes.",
    "Serve warm and enjoy.",
    "Refrigerate or freeze leftovers for up to 3 days."
  ],
