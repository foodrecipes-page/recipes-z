      "name": "lamb loin chops",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "dried oregano",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric",
      "amount": "1/2 teaspoon",
      "notes": "anti-inflammatory properties"
    },
    {
      "name": "ginger",
      "amount": "1/2 teaspoon",
      "notes": "anti-inflammatory properties"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "basil",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, garlic, lemon juice, honey, dried oregano, turmeric, ginger, salt, and black pepper.",
    "Add the lamb loin chops to the bowl and toss to coat with the marinade.",
    "Let the lamb marinate for at least 30 minutes.",
    "In a large skillet, heat 2 tablespoons of olive oil over medium-high heat.",
    "Remove the lamb from the marinade and cook until browned on all sides, about 5 minutes.",
    "Transfer the lamb to a 9x13 inch baking dish.",
    "In the same skillet, add the chopped basil and cook for 1 minute.",
    "Pour the basil mixture over the lamb in the baking dish.",
    "Bake the cassata in the preheated oven for 25 minutes.",
    "Let the cassata rest for 10 minutes before serving."
  ],
