{
  "title": "Zesty Chewy Sicilian Lamb Cassata",
  "description": "A tangy and chewy post-workout Italian dish featuring lamb loin chops, this cassata is emulsified with anti-inflammatory friendly ingredients.",
  "cuisine": "Sicilian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
