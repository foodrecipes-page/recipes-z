{
  "title": "Zero Gravity Brazilian Chicken Stew",
  "description": "A buttery and tender Brazilian dish featuring clotted cream, perfect for a weeknight dinner, with an ayurvedic sattvic friendly twist.",
  "cuisine": "Brazilian",
