      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "clotted cream",
      "amount": "1/2 cup",
      "notes": "extra rich"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chicken breast pieces and cook until they are browned on all sides.",
    "Add the cumin, paprika, salt, and black pepper, and stir to combine.",
    "Pour in the clotted cream and bring the mixture to a boil.",
    "Reduce the heat to low and simmer for 20 minutes, or until the chicken is cooked through.",
    "Stir in the butter until it is fully incorporated.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
