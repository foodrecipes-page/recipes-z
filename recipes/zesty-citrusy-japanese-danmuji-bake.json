  "ingredients": [
    {
      "name": "danmuji (korean-style pickled radish)",
      "amount": "1 cup, diced"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon",
      "notes": "optional"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "orange juice",
      "amount": "1/4 cup"
    },
    {
      "name": "yuzu juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "pinch"
    },
    {
      "name": "black pepper",
      "amount": "pinch"
    },
    {
      "name": "rice vinegar",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "preheat oven to 375f (190c).",
    "grease 4 ramekins with coconut oil.",
    "mix together danmuji, turmeric, and honey in a bowl.",
    "add in orange and yuzu juice, and mix until combined.",
    "season with salt and black pepper to taste.",
    "divide danmuji mixture among the ramekins.",
    "bake for 20 minutes, or until tops are lightly browned.",
    "remove from oven and brush with rice vinegar.",
    "allow to cool for 5 minutes before serving."
  ],
