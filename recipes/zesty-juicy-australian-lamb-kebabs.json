{
  "title": "Zesty Juicy Australian Lamb Kebabs",
  "description": "Tender lamb kebabs infused with zesty flavors, perfect for a sattvic dinner, rendered to perfection with lamb fat for a juicy meal prep option.",
  "cuisine": "Australian",
  "diet": [
