    {
      "name": "beef stew meat",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "milk chocolate",
      "amount": "1/4 cup",
      "notes": "dairy or dairy-free alternative"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tagine spice blend",
      "amount": "2 tablespoons",
      "notes": "or homemade blend"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup",
      "notes": "low-sodium"
    },
    {
      "name": "sour cream",
      "amount": "1/2 cup",
      "notes": "or dairy-free alternative"
    },
    {
      "name": "dried apricots",
      "amount": "1/4 cup",
      "notes": "unsweetened"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large Dutch oven or tagine, heat 2 tablespoons of oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional 1 minute.",
    "Add the beef cubes and cook until browned on all sides, about 5 minutes.",
    "Add the tagine spice blend, chicken broth, and dried apricots, stirring to combine.",
    "Cover the pot and transfer to the preheated oven.",
    "Bake for 2 1/2 hours, or until the beef is tender.",
    "Stir in the milk chocolate until melted and smooth.",
    "Serve hot, topped with a dollop of sour cream."
  ],
