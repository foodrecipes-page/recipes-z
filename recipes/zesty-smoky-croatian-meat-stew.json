  "ingredients": [
    {
      "name": "beef stew meat",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "yellow curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "kombu cold extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat.",
    "Add the beef and cook until browned on all sides, about 5 minutes.",
    "Add the onion and garlic and cook until the onion is translucent, about 5 minutes.",
    "Add the curry paste, kombu extract, smoked paprika, salt, and pepper, and cook for 1 minute.",
    "Add the chicken broth and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Serve hot, garnished with fresh parsley if desired.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
