  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "boneless and skinless"
    },
    {
      "name": "walnuts",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "heavy coconut cream",
      "amount": "1 cup",
      "notes": "full fat"
    },
    {
      "name": "aji amarillo pepper paste",
      "amount": "2 tablespoons",
      "notes": "or substitute with hot sauce"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Season the chicken breast with salt and black pepper.",
    "In a blender or food processor, combine the walnuts, coconut cream, aji amarillo pepper paste, and garlic, and blend until smooth.",
    "In a large skillet, heat the blended sauce over medium heat, whisking constantly.",
    "Add the chicken breast to the skillet and cook until browned on both sides.",
    "Transfer the skillet to the preheated oven and bake for 25 minutes, or until the chicken is cooked through.",
    "Remove the skillet from the oven and stir in the chopped parsley.",
    "Serve the chicken hot, spooning the creamy sauce over the top."
  ],
