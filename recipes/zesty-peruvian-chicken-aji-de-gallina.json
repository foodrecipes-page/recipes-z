{
  "title": "Zesty Peruvian Chicken Aji De Gallina",
  "description": "A creamy and tangy Peruvian dish featuring chicken, hotsauce, and a dairy-free friendly sauce, perfect for a date-night dinner.",
  "cuisine": "Peruvian",
  "diet": [
    "dairy-free",
    "gluten-free"
