{
  "title": "Zesty Ukrainian Fromage Bake",
  "description": "A spicy, tender, satvik-friendly solo-dinner featuring fromage frais, perfect for a weeknight",
  "cuisine": "ukrainian",
  "diet": [
    "vegetarian"
  ],
