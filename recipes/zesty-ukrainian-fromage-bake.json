    {
      "name": "fromage frais",
      "amount": "8 oz",
      "notes": "softened fromage frais at room temperature"
    },
    {
      "name": "cottage cheese",
      "amount": "12 oz",
      "notes": "drained and crumbled"
    },
    {
      "name": "egg",
      "amount": "1",
      "notes": ""
    },
    {
      "name": "flour",
      "amount": "1 cup",
      "notes": ""
    },
    {
      "name": "salt",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "paprika",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp",
      "notes": "freshly ground"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tbsp",
      "notes": "melted"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F",
    "In a mixing bowl, combine fromage frais and cottage cheese",
    "Add egg, flour, salt, paprika, garlic powder, and black pepper to the bowl and mix",
    "Roll out the dough to a thickness of 1/4 inch and transfer to a greased 8-inch round baking dish",
    "Dot the top of the dough with melted butter",
    "Bake for 25 minutes, or until the crust is golden brown and the filling is set",
    "Let cool for 5 minutes before slicing and serving"
  ],
